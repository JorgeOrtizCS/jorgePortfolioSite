# Normalize line endings. Repo stores LF, checkouts use LF everywhere.
# Without this, a Windows checkout rewrites every file to CRLF and git
# reports the whole tree as modified.
* text=auto eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
